rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email in [
          'alekcaballeromusic@gmail.com',
          'catalina.medina.leal@gmail.com'
        ];
    }

    /* Validación de forma.
       Las reglas ya controlaban QUIÉN escribe; esto controla QUÉ escribe.
       Es la última línea de defensa: funciona aunque el bug esté en el
       cliente, que fue exactamente lo que pasó la vez que se perdió todo. */
    function hasValidShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['app', 'data'])
        && d.app == 'maleta-checklist'
        && d.data is map
        && d.data.keys().hasAll(['lists', 'items', 'activeListId'])
        && d.data.lists is list
        && d.data.items is list
        && d.data.activeListId is string
        && d.data.lists.size() > 0        // nunca sin ninguna lista
        && d.data.lists.size() <= 100
        && d.data.items.size() <= 5000;
    }

    /* Guardia anti-vaciado del lado servidor.
       Rechaza una escritura que deje 0 ítems cuando el documento existente
       sí tenía. Vaciar de verdad sigue siendo posible: se hace en dos pasos
       (o borrando ítems por tandas), pero nunca de un solo golpe accidental. */
    function isNotMassWipe() {
      return !(resource != null
        && resource.data.data.items.size() > 0
        && request.resource.data.data.items.size() == 0);
    }

    // Documento vivo del checklist.
    match /apps/maleta-checklist {
      allow read: if isAllowedUser();
      allow write: if isAllowedUser() && hasValidShape() && isNotMassWipe();
    }

    /* Historial de versiones: se puede leer y crear, pero NO modificar ni
       borrar. Así el respaldo no se puede destruir desde la app, ni por
       error ni por un bug. El borrado real lo hace la política TTL sobre
       el campo expiresAt. */
    match /apps/maleta-checklist/versiones/{versionId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser() && hasValidShape();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
